REM Local reviewed setup on CIRCUITPY. Requires keyboard WIN_BR.
DELAY 15000
SAVE_HOST_KEYBOARD_LOCK_STATE
VAR $DEMO_SAVED_CAPS = $_INITIAL_CAPSLOCK
$_INITIAL_CAPSLOCK = FALSE
RESTORE_HOST_KEYBOARD_LOCK_STATE
DELAY 100
GUI r
DELAY 1500
STRING powershell -NoProfile -STA
ENTER
DELAY 10000
STRING $ErrorActionPreference='Stop';$v=@(foreach($d in [IO.DriveInfo]::GetDrives()){if($d.DriveType -ne [IO.DriveType]::Fixed -and $d.DriveType -ne [IO.DriveType]::Removable){continue};try{if($d.get_IsReady() -and $d.get_VolumeLabel() -eq 'CIRCUITPY'){$d}}catch{throw 'Nao foi possivel verificar as unidades. Aguarde e repita.'}});if($v.Count -ne 1){throw 'CIRCUITPY ausente ou duplicado.'};$p=[IO.Path]::Combine($v[0].RootDirectory.FullName,'CIBER_T2\PREPARAR_DEMO.ps1');if((Get-FileHash -LiteralPath $p -Algorithm SHA256).Hash -ne '6CDFD2948EFC68CD011FDFFB40687BC8F75C26FDF43F78755770A083E622937D'){throw 'Preparador USB diferente do esperado.'};@(Get-Content -LiteralPath $p -ErrorAction Stop;'') | & ($env:SystemRoot+'\System32\WindowsPowerShell\v1.0\powershell.exe') -NoLogo -NoProfile -STA -Command -;if($LASTEXITCODE -ne 0){Write-Host 'Preparacao falhou. Leia as mensagens acima.' -ForegroundColor Red}
$_INITIAL_CAPSLOCK = $DEMO_SAVED_CAPS
RESTORE_HOST_KEYBOARD_LOCK_STATE
DELAY 100
ENTER
